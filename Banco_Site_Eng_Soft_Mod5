-- Tabela: categoria_gasto
CREATE TABLE categoria_gasto (
    id_categoria_gasto INT PRIMARY KEY AUTO_INCREMENT,
    nome_categoria VARCHAR(50) NOT NULL,
    descricao VARCHAR(255)
);

-- Tabela: funcionario
CREATE TABLE funcionario (
    id_funcionario INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    telefone VARCHAR(15),
    cidade VARCHAR(100),
    bairro VARCHAR(100),
    perfil_acesso ENUM('admin', 'gerente', 'funcionario') NOT NULL,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    ativo TINYINT(1) DEFAULT 1
);

-- Tabela: registro_ponto
CREATE TABLE registro_ponto (
    id_registro INT PRIMARY KEY AUTO_INCREMENT,
    id_funcionario INT NOT NULL,
    data_registro DATE NOT NULL,
    horario TIME NOT NULL,
    tipo_registro ENUM('entrada', 'saida', 'pausa_inicio', 'pausa_fim') NOT NULL,
    observacoes VARCHAR(255),
    data_hora_registro DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_funcionario) REFERENCES funcionario(id_funcionario)
);

-- Tabela: usuario
CREATE TABLE usuario (
    id_usuario INT PRIMARY KEY AUTO_INCREMENT,
    nome_completo VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    telefone VARCHAR(15),
    endereco VARCHAR(255),
    login VARCHAR(50) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    ativo TINYINT(1) DEFAULT 1
);

-- Tabela: gasto
CREATE TABLE gasto (
    id_gasto INT PRIMARY KEY AUTO_INCREMENT,
    id_categoria_gasto INT NOT NULL,
    descricao VARCHAR(255) NOT NULL,
    valor DECIMAL(10,2) NOT NULL,
    data_gasto DATE NOT NULL,
    forma_pagamento ENUM('dinheiro', 'cartao_credito', 'cartao_debito', 'pix', 'transferencia') NOT NULL,
    fornecedor VARCHAR(100),
    numero_nota VARCHAR(50),
    observacoes TEXT,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_categoria_gasto) REFERENCES categoria_gasto(id_categoria_gasto)
);

-- Tabela: movimentacao_estoque
CREATE TABLE movimentacao_estoque (
    id_movimentacao INT PRIMARY KEY AUTO_INCREMENT,
    id_insumo INT NOT NULL,
    id_funcionario INT NOT NULL,
    tipo_movimentacao ENUM('entrada', 'saida', 'ajuste', 'perda') NOT NULL,
    quantidade DECIMAL(10,2) NOT NULL,
    motivo VARCHAR(255),
    data_movimentacao DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Tabela: categoria_insumo
CREATE TABLE categoria_insumo (
    id_categoria_insumo INT PRIMARY KEY AUTO_INCREMENT,
    nome_categoria VARCHAR(50) NOT NULL,
    descricao VARCHAR(255)
);

-- Tabela: insumo
CREATE TABLE insumo (
    id_insumo INT PRIMARY KEY AUTO_INCREMENT,
    id_categoria_insumo INT NOT NULL,
    nome_insumo VARCHAR(100) NOT NULL,
    unidade_medida ENUM('kg', 'g', 'l', 'ml', 'unidade', 'pacote') NOT NULL,
    quantidade_estoque DECIMAL(10,2) NOT NULL DEFAULT 0,
    estoque_minimo DECIMAL(10,2) NOT NULL,
    custo_unitario DECIMAL(10,2) NOT NULL,
    fornecedor VARCHAR(100),
    data_validade DATE,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    data_ultima_atualizacao DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (id_categoria_insumo) REFERENCES categoria_insumo(id_categoria_insumo)
);

-- Adicionar chave estrangeira em movimentacao_estoque
ALTER TABLE movimentacao_estoque
ADD FOREIGN KEY (id_insumo) REFERENCES insumo(id_insumo),
ADD FOREIGN KEY (id_funcionario) REFERENCES funcionario(id_funcionario);

-- Tabela: Gramagem
CREATE TABLE Gramagem (
    idGramagem INT PRIMARY KEY AUTO_INCREMENT,
    unidade VARCHAR(20) NOT NULL,
    Quantidade DECIMAL(10) NOT NULL,
    Gramageacao VARCHAR(45),
    insumo_id_insumo INT NOT NULL,
    FOREIGN KEY (insumo_id_insumo) REFERENCES insumo(id_insumo)
);

-- Tabela: produto
CREATE TABLE produto (
    id_produto INT PRIMARY KEY AUTO_INCREMENT,
    id_categoria INT NOT NULL,
    nome_produto VARCHAR(100) NOT NULL,
    descricao TEXT,
    preco DECIMAL(10,2) NOT NULL,
    preco_antigo DECIMAL(10,2),
    em_promocao TINYINT(1) DEFAULT 0,
    mais_vendido TINYINT(1) DEFAULT 0,
    tempo_preparo VARCHAR(20),
    porcoes VARCHAR(50),
    tipo VARCHAR(50),
    imagem_url VARCHAR(500),
    icone VARCHAR(50),
    disponivel TINYINT(1) DEFAULT 1,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    Gramagem_idGramagem INT,
    FOREIGN KEY (Gramagem_idGramagem) REFERENCES Gramagem(idGramagem)
);

-- Tabela: categoria_cardapio
CREATE TABLE categoria_cardapio (
    id_categoria INT PRIMARY KEY AUTO_INCREMENT,
    nome_categoria VARCHAR(50) NOT NULL,
    descricao VARCHAR(255),
    icone VARCHAR(50),
    ordem_exibicao INT
);

-- Adicionar chave estrangeira em produto
ALTER TABLE produto
ADD FOREIGN KEY (id_categoria) REFERENCES categoria_cardapio(id_categoria);

-- Tabela: receita
CREATE TABLE receita (
    id_receita INT PRIMARY KEY AUTO_INCREMENT,
    id_produto INT NOT NULL,
    quantidade_necessaria DECIMAL(10,3) NOT NULL,
    observacao VARCHAR(255),
    FOREIGN KEY (id_produto) REFERENCES produto(id_produto)
);

-- Tabela: itemreceita
CREATE TABLE itemreceita (
    insumo_id_insumo INT NOT NULL,
    receita_id_receita INT NOT NULL,
    qtInsumo DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (insumo_id_insumo, receita_id_receita),
    FOREIGN KEY (insumo_id_insumo) REFERENCES insumo(id_insumo),
    FOREIGN KEY (receita_id_receita) REFERENCES receita(id_receita)
);

-- Tabela: cliente
CREATE TABLE cliente (
    id_cliente INT PRIMARY KEY AUTO_INCREMENT,
    nome_completo VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE,
    telefone VARCHAR(15),
    cpf VARCHAR(14) UNIQUE,
    data_nascimento DATE,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    total_pedidos INT DEFAULT 0,
    ticket_medio DECIMAL(10,2) DEFAULT 0,
    ativo TINYINT(1) DEFAULT 1
);

-- Tabela: mesa
CREATE TABLE mesa (
    id_mesa INT PRIMARY KEY AUTO_INCREMENT,
    numero_mesa INT NOT NULL UNIQUE,
    capacidade INT NOT NULL,
    localizacao ENUM('interna', 'externa', 'varanda') NOT NULL,
    tipo_mesa ENUM('regular', 'reservada', 'vip') NOT NULL,
    status ENUM('livre', 'ocupada', 'reservada') DEFAULT 'livre',
    observacoes TEXT
);

-- Tabela: reserva
CREATE TABLE reserva (
    id_reserva INT PRIMARY KEY AUTO_INCREMENT,
    id_cliente INT NOT NULL,
    id_mesa INT NOT NULL,
    nome_cliente VARCHAR(100) NOT NULL,
    telefone VARCHAR(15) NOT NULL,
    email VARCHAR(100),
    data_reserva DATE NOT NULL,
    horario TIME NOT NULL,
    numero_pessoas INT NOT NULL,
    observacoes TEXT,
    status_reserva ENUM('confirmada', 'cancelada', 'concluida', 'pendente') DEFAULT 'pendente',
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),
    FOREIGN KEY (id_mesa) REFERENCES mesa(id_mesa)
);

-- Tabela: avaliacao
CREATE TABLE avaliacao (
    id_avaliacao INT PRIMARY KEY AUTO_INCREMENT,
    id_cliente INT NOT NULL,
    nome_cliente VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    nota INT NOT NULL CHECK (nota BETWEEN 1 AND 5),
    comentario TEXT,
    data_avaliacao DATETIME DEFAULT CURRENT_TIMESTAMP,
    aprovada TINYINT(1) DEFAULT 0,
    FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente)
);

-- Criar índices para melhor performance
CREATE INDEX idx_funcionario_cpf ON funcionario(cpf);
CREATE INDEX idx_funcionario_email ON funcionario(email);
CREATE INDEX idx_registro_ponto_data ON registro_ponto(data_registro);
CREATE INDEX idx_gasto_data ON gasto(data_gasto);
CREATE INDEX idx_insumo_nome ON insumo(nome_insumo);
CREATE INDEX idx_produto_nome ON produto(nome_produto);
CREATE INDEX idx_cliente_cpf ON cliente(cpf);
CREATE INDEX idx_reserva_data ON reserva(data_reserva);
CREATE INDEX idx_avaliacao_data ON avaliacao(data_avaliacao);